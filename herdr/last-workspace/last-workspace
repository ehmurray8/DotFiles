#!/bin/sh

set -eu

state_dir="${HERDR_PLUGIN_STATE_DIR:?HERDR_PLUGIN_STATE_DIR is required}"
current_file="$state_dir/current-workspace"
previous_file="$state_dir/previous-workspace"
mkdir -p "$state_dir"

read_state() {
    file="$1"
    if [ -f "$file" ]; then
        IFS= read -r value < "$file" || true
        printf '%s' "$value"
    fi
}

write_state() {
    file="$1"
    value="$2"
    temporary="$file.tmp.$$"
    printf '%s\n' "$value" > "$temporary"
    mv "$temporary" "$file"
}

track_workspace() {
    workspace_id=$(printf '%s' "${HERDR_PLUGIN_EVENT_JSON:-}" | jq -r '
        .workspace.workspace_id //
        .workspace.id //
        .workspace_id //
        .payload.workspace_id //
        .data.workspace_id //
        empty
    ')
    workspace_id=${workspace_id:-${HERDR_WORKSPACE_ID:-}}
    [ -n "$workspace_id" ] || exit 0

    current=$(read_state "$current_file")
    if [ "$workspace_id" != "$current" ]; then
        [ -n "$current" ] && write_state "$previous_file" "$current"
        write_state "$current_file" "$workspace_id"
    fi
}

toggle_workspace() {
    current=$(read_state "$current_file")
    previous=$(read_state "$previous_file")
    [ -n "$previous" ] || exit 0
    [ "$previous" != "$current" ] || exit 0

    "$HERDR_BIN_PATH" workspace focus "$previous"
}

case "${1:-}" in
    track) track_workspace ;;
    toggle) toggle_workspace ;;
    *) exit 2 ;;
esac
