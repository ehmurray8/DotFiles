{
  "$schema": "https://opencode.ai/config.json",
  "lsp": "true",
  "plugin": ["opencode-gitlab-plugin"],
  "agent": {
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability. If we find a security issue delegate to @security-engineer",
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    },
    "security-engineer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "prompt": "You are a security engineer. Focus on security, you'll be given tasks to figure out whether there's a risky code snippet or CVE we need to address with versions.",
      "permission": {
        "edit": "deny",
        "write": "deny"
      }
    }
  },
  "permission": {
    "bash": {
      "git *": "allow",
      "git add*": "ask",
      "git restore*": "ask",
      "git stash*": "ask",
      "git clean*": "deny",
      "git commit*": "ask",
      "git amend*": "ask",
      "git rebase*": "ask",
      "git cherry-pick*": "deny",
      "git revert*": "deny",
      "git reset*": "deny",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git branch -d*": "deny",
      "git branch -D*": "deny",
      "git merge*": "ask",
      "git push*": "ask",
      "git pull*": "ask",
      "git clone*": "ask",
      "git remote add*": "deny",
      "git remote remove*": "deny",
      "git remote set-url*": "deny",
      "git tag*": "deny",
      "glab *": "ask",
      "glab mr list*": "allow",
      "glab mr view*": "allow",
      "glab mr create*": "ask",
      "glab mr update*": "ask",
      "glab mr merge*": "ask",
      "grep *": "allow",
      "rg *": "allow",
      "npm *": "allow",
      "rm *": "deny"
    }
  }
}
